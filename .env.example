# Set your password in the local browser on first use, or scripts/password.py.
# Password hashes are stored in .runtime/credentials.json (0600).
ORH_HOST=127.0.0.1
ORH_PORT=8765
ORH_ZELLIJ_PORT=8082
# LAN / private overlay: set ORH_HOST=0.0.0.0 and list destination IPs/names here.
# No scheme or port; ORH_PORT is used for every address. Localhost is always allowed.
# ORH_ALLOWED_HOSTS=192.168.1.20,100.66.1.2,server.local
ORH_ALLOWED_HOSTS=

# Explicit authorized file roots as a JSON array. Empty means no file access.
# Host-wide browsing (system paths read-only, credential paths protected): ["/"]
# Or restrict to projects: ["/Users/you/Projects"] / ["/home/you/projects"]
ORH_FILE_ROOTS=[]
# Raw streaming uploads; no in-memory multipart buffering. Existing files never overwritten.
ORH_MAX_UPLOAD_MB=2048

# Native DeepSeek Harness Web (0.2.x); no packages are installed automatically.
# Console login also authenticates this isolated native-UI gateway.
ORH_DSH_ENABLED=0
ORH_DSH_GATEWAY_PORT=8767
# Native DSH remains loopback-only. All ports must be distinct when enabled.
ORH_DSH_PORT=9741
# Optional: installed CLI executable or bin.js; Desktop's bundled CLI is detected.
# ORH_DSH_BIN=/Applications/DeepSeek Harness.app/Contents/Resources/runtime/cli/bin/dsh
# ORH_DSH_HOME=/Users/you/.dsh

# Projects page discovers direct child directories here (within ORH_FILE_ROOTS).
# ORH_PROJECTS_DIR=/Users/you/Projects
